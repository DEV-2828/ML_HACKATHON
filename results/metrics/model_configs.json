{
  "random_seed": 42,
  "cv_strategy": "GroupKFold(n_splits=5, group=trip_id)",
  "train_trips": 80,
  "student_test_trips": 10,
  "feature_cols": [
    "distance_to_arc_m",
    "signed_lateral_m",
    "distance_to_arc_midpoint_m",
    "distance_to_nearest_endpoint_m",
    "arc_length_m",
    "gps_heading_sin_delta",
    "gps_heading_cos_delta",
    "gps_speed_mps",
    "gps_step_distance_m",
    "gps_time_delta_s",
    "gps_turn_angle_rad",
    "point_to_arc_along_fraction"
  ],
  "models": {
    "LogisticRegression": {
      "family": "Linear / Probabilistic",
      "loss_objective": "L2-regularised Binary Cross-Entropy (Log Loss)",
      "preprocessing": "SimpleImputer(median) + StandardScaler",
      "hyperparameters": {
        "C": 1.0,
        "solver": "lbfgs",
        "max_iter": 1000,
        "class_weight": "balanced",
        "random_state": 42
      },
      "history_file": null
    },
    "DecisionTree": {
      "family": "Tree-based",
      "loss_objective": "Gini Impurity",
      "preprocessing": "SimpleImputer(median)",
      "hyperparameters": {
        "criterion": "gini",
        "max_depth": 12,
        "min_samples_leaf": 20,
        "class_weight": "balanced",
        "random_state": 42
      },
      "history_file": null
    },
    "RandomForest": {
      "family": "Ensemble (Bagging)",
      "loss_objective": "Gini Impurity (Subsampled Bagged Ensemble)",
      "preprocessing": "SimpleImputer(median)",
      "hyperparameters": {
        "n_estimators": 100,
        "max_depth": 16,
        "min_samples_leaf": 10,
        "max_samples": 0.4,
        "class_weight": "balanced_subsample",
        "n_jobs": -1,
        "random_state": 42
      },
      "history_file": null
    },
    "ExtraTrees": {
      "family": "Ensemble (Randomized Trees)",
      "loss_objective": "Gini Impurity (Extremely Randomized Splits)",
      "preprocessing": "SimpleImputer(median)",
      "hyperparameters": {
        "n_estimators": 100,
        "max_depth": 18,
        "min_samples_leaf": 10,
        "bootstrap": true,
        "max_samples": 0.4,
        "class_weight": "balanced_subsample",
        "n_jobs": -1,
        "random_state": 42
      },
      "history_file": null
    },
    "XGBoost": {
      "family": "Boosting",
      "loss_objective": "Binary Logistic Loss (binary:logistic / logloss)",
      "preprocessing": "SimpleImputer(median)",
      "hyperparameters": {
        "n_estimators": 200,
        "max_depth": 6,
        "learning_rate": 0.1,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "min_child_weight": 5,
        "tree_method": "hist",
        "eval_metric": "logloss",
        "n_jobs": -1,
        "random_state": 42
      },
      "history_file": "results\\metrics\\history_XGBoost.csv"
    },
    "MLP": {
      "family": "Neural Network",
      "loss_objective": "L2-regularised Binary Cross-Entropy (Adam optimiser)",
      "preprocessing": "SimpleImputer(median) + StandardScaler",
      "hyperparameters": {
        "hidden_layer_sizes": [
          64,
          32
        ],
        "activation": "relu",
        "solver": "adam",
        "alpha": 0.001,
        "batch_size": 2048,
        "learning_rate_init": 0.001,
        "max_iter": 15,
        "early_stopping": false,
        "random_state": 42
      },
      "history_file": "results\\metrics\\history_MLP.csv"
    }
  }
}